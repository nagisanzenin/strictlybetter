{
  "_comment": "Metric card skeleton (docs/02 §2.1, JSON form). Keys prefixed with _comment are documentation and are stripped by `sb card add`. Everything else is required unless marked optional. Placeholders in {{...}} must be replaced by the metrologist before `sb card validate` will pass.",
  "id": "{{metric_id}}",
  "_comment_id": "snake_case, unique within the project; the ledger, baseline and campaign refer to it by this string.",
  "title": "{{human title, one line}}",
  "kind": "goal",
  "_comment_kind": "goal | guardrail | diagnostic. A goal must improve, a guardrail must hold, a diagnostic is recorded and never decides anything. A card without a measured noise.sigma cannot be a goal.",
  "direction": "minimize",
  "_comment_direction": "maximize | minimize | equal. equal is for guardrails that must match the baseline exactly (counts, sizes, API surface); its degradation probe passes when the value differs.",
  "unit": "{{unit}}",
  "measure": {
    "command": "{{shell command run with sh -c from cwd; must exit 0 on a valid run and print the value in the form `parse` expects}}",
    "parse": "metric-line:{{metric_id}}",
    "_comment_parse": "regex:<pattern with exactly one capture group> | json:<dotted.path into stdout JSON> | metric-line:<name> (stdout contains a line `METRIC <name>=<value>`). One mode per card.",
    "cwd": ".",
    "timeout_s": 600,
    "env": {},
    "_comment_env": "Pinned environment for the measurement process. Seeds, thread counts, hash seeds and budgets live here, never inside the code under test.",
    "expected_duration_s": [0.5, 600],
    "_comment_expected_duration_s": "Validity band. A run outside it is `discard: invalid`, never a candidate. Tight bands catch zero-second training runs and benchmarks that finish before warm-up."
  },
  "fidelity": {
    "_comment": "Each level overrides only what differs from `measure` (command, env, expected_duration_s, repeats). screen is what experiments see; full re-measures promoted candidates; confirm is run by the harness from a clean checkout with holdout inputs and decides acceptance. A level with {\"skip\": true} is not measured at that fidelity (confirm-only guardrails such as a held-out test split).",
    "screen": {"repeats": 1},
    "full": {"repeats": 1},
    "confirm": {
      "repeats": 3,
      "max_repeats": 6,
      "_comment_max_repeats": "Cap for the inconclusive path (docs/03 JUDGE). The harness adds repeats up to this cap and then discards as noise; unbounded re-measurement is the adaptive querying the Ladder guards against.",
      "holdout": {"kind": "env", "var": "SB_SEED", "values": [1913, 8241, 6607]},
      "_comment_holdout": "Optional. {kind: env, var, values} sets the variable per repeat; {kind: arg, values} substitutes {holdout} in the confirm command; {kind: dir, name} copies .strictlybetter/holdout/<name>/ into the clean checkout. The experimenter never sees these values."
    }
  },
  "acceptance": {
    "kappa": 2.5,
    "tolerance_sigma": 1.0,
    "_comment": "As a goal: improvement must exceed kappa × sigma (raised by the complexity regularizer for large diffs). As a guardrail: may not move the wrong way by more than tolerance_sigma × sigma; 0 means any regression fails. Do not tune these to results."
  },
  "integrity": {
    "frozen_paths": ["{{path the experimenter may not touch for this metric to be trusted}}"],
    "_comment": "Hashed at campaign start into campaign.eval_hash together with the other cards' frozen paths. Any diff touching them is rejected before measurement and halts the campaign."
  },
  "degradation": {
    "apply": "{{shell command that makes the metric worse in a throwaway worktree, e.g. insert a sleep in the hot function, append an unused import, break one assertion's target}}",
    "expected": "worse",
    "_comment": "Monotonicity selftest (docs/02 §2.6 step 5). `sb card probe` applies this and requires the metric to move the wrong way by more than sigma. A card that cannot detect a deliberate regression cannot be a goal or a guardrail."
  },
  "gaming_risks": [
    "{{one line per way this number could be inflated without the property improving}}"
  ],
  "_comment_gaming_risks": "Written by the metrologist, read by the blind judge against the diff. Be specific to this command: what the fixture looks like, what the parser trusts, what the command cannot see.",
  "contention_safe": false,
  "_comment_contention_safe": "true for counts and sizes (may be measured in parallel with other worktrees); false for anything timed or memory-dependent (measured serially).",
  "noise": null,
  "_comment_noise": "Filled by `sb baseline`, never by hand: {sigma, samples, method, measured_at, environment_fingerprint, fidelity: {screen: {...}, full: {...}}}. A goal with noise: null is refused."
}
