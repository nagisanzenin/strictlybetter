{
  "_comment": "Metric card skeleton (docs/02 §2.1, JSON form). Keys prefixed with _comment are documentation and are stripped by `sb card add`. Everything else is required unless marked optional. Placeholders in {{...}} must be replaced by the metrologist before `sb card validate` will pass.",
  "id": "{{metric_id}}",
  "_comment_id": "snake_case, unique within the project; the ledger, baseline and campaign refer to it by this string.",
  "title": "{{human title, one line}}",
  "targets": ["{{code path the metric measures, e.g. src/}}"],
  "_comment_targets": "Goals: the code whose change would move this metric (never the instrument). campaign start halts a goal whose targets are all frozen; \"control\": true keeps it as a negative control.",
  "kind": "goal",
  "_comment_kind": "goal | guardrail | diagnostic. A goal must improve, a guardrail must hold, a diagnostic is recorded and never decides anything. A card without a measured noise.sigma cannot be a goal. The real instrument of a proxy ladder also keeps kind goal; what makes it an audit card is the `audit` block and the campaign's `audits` list (docs/15).",
  "proxy_for": null,
  "_comment_proxy_for": "Optional (docs/15). The id of the real metric's card this card stands in for: a stage replayed from recorded intermediates, or the pipeline on a frozen slice. A proxy is listed as a campaign goal; its screen and confirm levels, the exact test, and the ratchet apply to it as to any goal. campaign start refuses a proxy whose proxy_for is not in the campaign's audits list.",
  "trust": null,
  "_comment_trust": "Engine-owned; leave null. provisional (set at campaign start) | validated | suspect | demoted, moved only by audits on fixed thresholds (docs/14 §14.12). Not part of the card fingerprint. A demoted proxy no longer covers any target at pre-registration.",
  "covers": [],
  "_comment_covers": "Proxies only. Repo-relative path patterns (dir/ prefix, glob, exact path) the proxy is valid for: the stage's paths for a component proxy. Empty means every target (a slice proxy). In a campaign with audits, `sb prereg` refuses a hypothesis whose target matches no non-demoted proxy's covers unless some non-demoted proxy has none. Distinct from targets.",
  "audit": null,
  "_comment_audit": "The real instrument of a proxy ladder only: {\"every_accepts\": 3, \"discard_sample_rate\": 0.1, \"pairs\": 3, \"alpha\": 0.05} (these are the defaults). Audits run at the first accept and then every every_accepts accepts (head vs the last audited commit, pairs interleaved pairs at the card's confirm fidelity), on a sampled discard_sample_rate of proxy discards (one pair vs the experiment's base), and at campaign end (head vs base). 3 pairs is a direction check (smallest p 0.125); 5 or more can reach confirmed at 0.05. The card goes under the campaign's audits, never under goals.",
  "direction": "minimize",
  "_comment_direction": "maximize | minimize | equal. equal is for guardrails that must match the baseline exactly (counts, sizes, API surface); its degradation probe passes when the value differs.",
  "unit": "{{unit}}",
  "measure": {
    "command": "{{shell command run with sh -c from cwd; must exit 0 on a valid run and print the value in the form `parse` expects}}",
    "parse": "metric-line:{{metric_id}}",
    "_comment_parse": "regex:<pattern with exactly one capture group> | json:<dotted.path into stdout JSON> | metric-line:<name> (stdout contains a line `METRIC <name>=<value>`). One mode per card.",
    "cwd": ".",
    "timeout_s": 600,
    "env": {},
    "_comment_env": "Pinned environment for the measurement process. Seeds, thread counts, hash seeds and budgets live here, never inside the code under test.",
    "expected_duration_s": [0.5, 600],
    "_comment_expected_duration_s": "Validity band. A run outside it is `discard: invalid`, never a candidate. lo = the instrument's fixed cost (process start + input generation), never a fraction of the baseline, so a genuine 25x win is still a valid run; hi about 5x the baseline duration. Tight lower bounds catch zero-second training runs."
  },
  "fidelity": {
    "_comment": "Each level overrides only what differs from `measure` (command, env, expected_duration_s, repeats). screen is what experiments see; full re-measures promoted candidates; confirm is run by the harness from a clean checkout with holdout inputs and decides acceptance. A level with {\"skip\": true} is not measured at that fidelity (confirm-only guardrails such as a held-out test split).",
    "screen": {"repeats": 1},
    "full": {"repeats": 1},
    "confirm": {
      "repeats": 3,
      "max_repeats": 6,
      "_comment_max_repeats": "Cap for the inconclusive path (docs/03 JUDGE). The harness adds repeats up to this cap and then discards as noise; unbounded re-measurement is the adaptive querying the Ladder guards against.",
      "holdout": {"kind": "env", "var": "SB_SEED", "values": [1913, 8241, 6607]},
      "_comment_holdout": "Optional. {kind: env, var, values} sets the variable per repeat; {kind: arg, values} substitutes {holdout} in the confirm command; {kind: dir, name} copies .strictlybetter/holdout/<name>/ into the clean checkout. The experimenter never sees these values."
    }
  },
  "acceptance": {
    "kappa": 2.5,
    "tolerance_sigma": 1.0,
    "_comment": "As a goal: improvement must exceed kappa × sigma (raised by the complexity regularizer for large diffs). As a guardrail: may not move the wrong way by more than tolerance_sigma × sigma; 0 means any regression fails. Do not tune these to results."
  },
  "integrity": {
    "frozen_paths": ["{{path the experimenter may not touch for this metric to be trusted}}"],
    "_comment": "Hashed at campaign start into campaign.eval_hash together with the other cards' frozen paths. Any diff touching them is rejected before measurement and halts the campaign.",
    "external_paths": [],
    "_comment_external_paths": "Optional. Absolute paths OUTSIDE the repo this number depends on (a harness in a sibling repo). Merged with the campaign's external_instruments, content-hashed at campaign start into campaign.external_hashes, re-checked before every decision (halt external-tampered:<path>), and denied to the experimenter by the guard. A path inside the repo is refused at start: use frozen_paths. Part of the card fingerprint."
  },
  "services": null,
  "_comment_services": "Optional. null, or {setup, ready, teardown, cwd, ready_timeout_s: 120, ready_interval_s: 2, setup_timeout_s: 600, teardown_timeout_s: 300}, the same shape as the campaign spec's services. Brought up around each measurement of this card, in the checkout (or cwd under it) with SB_CHECKOUT set; ready is polled until exit 0 or the timeout; teardown always runs. Setup failure or readiness timeout makes the measurement invalid, never a crash. Use the campaign-level services for what every card needs. Part of the card fingerprint.",
  "degradation": {
    "apply": "{{shell command that makes the metric worse in a throwaway worktree, e.g. insert a sleep in the hot function, append an unused import, break one assertion's target}}",
    "expected": "worse",
    "_comment": "Monotonicity selftest (docs/02 §2.6 step 5). `sb card probe` applies this and requires the metric to move the wrong way by more than sigma. A card that cannot detect a deliberate regression cannot be a goal or a guardrail."
  },
  "gaming_risks": [
    "{{one line per way this number could be inflated without the property improving}}"
  ],
  "_comment_gaming_risks": "Written by the metrologist, read by the blind judge against the diff. Be specific to this command: what the fixture looks like, what the parser trusts, what the command cannot see.",
  "contention_safe": false,
  "_comment_contention_safe": "true for counts and sizes (may be measured in parallel with other worktrees); false for anything timed or memory-dependent (measured serially).",
  "noise": null,
  "_comment_noise": "Filled by `sb baseline`, never by hand: {sigma, samples, method, measured_at, environment_fingerprint, fidelity: {screen: {...}, full: {...}}}. A goal with noise: null is refused."
}
