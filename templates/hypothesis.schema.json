{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nagisanzenin/researchloop/templates/hypothesis.schema.json",
  "title": "strictlybetter pre-registered hypothesis",
  "description": "docs/03 \u00a7HYPOTHESIZE plus `mechanism`. `sb prereg --file` validates this and writes the ledger line before any diff exists. The operator must be one of the 13 ids in operators/. Predicted effects are strings in the form <signed number>[..<signed number>][ unit] so the harness can compare them to confirmed effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operator",
    "target",
    "hypothesis",
    "mechanism",
    "predicted",
    "expected_diff_size"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^e[0-9]{4,}$"
    },
    "operator": {
      "$ref": "#/definitions/operator"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "A path, or path:symbol. A diff whose primary target differs is a new hypothesis."
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "mechanism": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000,
      "description": "Why the change should move the metric, grounded in evidence. Required; science projects (docs/07 \u00a77.4) are held to a higher bar by the distiller, not by this schema."
    },
    "predicted": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/effect"
      },
      "description": "One entry per goal, plus every guardrail the change could plausibly move. Metric ids must exist in the campaign's set."
    },
    "expected_diff_size": {
      "enum": [
        "tiny",
        "small",
        "medium",
        "large"
      ]
    },
    "est_cost_s": {
      "type": "number",
      "minimum": 0,
      "description": "Expected implementation plus screen-measurement wall-clock."
    },
    "evidence": {
      "type": "string",
      "maxLength": 1000
    },
    "archive_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,64}$"
      },
      "uniqueItems": true,
      "description": "Archive entries (by hash) the hypothesis recombines."
    },
    "enables": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "target",
            "hypothesis",
            "predicted"
          ],
          "properties": {
            "operator": {
              "$ref": "#/definitions/operator"
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "hypothesis": {
              "type": "string",
              "minLength": 10
            },
            "predicted": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/definitions/effect"
              }
            }
          }
        }
      ],
      "description": "Required in practice for refactor-enabling: the follow-up move this stepping stone unlocks."
    }
  },
  "definitions": {
    "operator": {
      "enum": [
        "config",
        "algorithmic",
        "allocation",
        "caching",
        "concurrency",
        "dependency",
        "test-add",
        "bugfix",
        "refactor-enabling",
        "data",
        "model",
        "numerics",
        "docs"
      ]
    },
    "effect": {
      "type": "string",
      "pattern": "^(unchanged|[+-]?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?(\\.\\.[+-]?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?)?( ?(%|[A-Za-z][A-Za-z/_]*))?)$",
      "description": "Examples: \"+5..15%\", \"-0.01..-0.03\", \"-60..-72 kB\", \"0\", \"unchanged\". A range uses two dots. Units are optional; percent is relative to baseline."
    }
  }
}